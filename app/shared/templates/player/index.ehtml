import "./style.css";
import { Button } from "@elements/ui/button";
import { Icon } from "@elements/ui/icon";
import { Slider, SliderChangeDetails } from "@elements/ui/slider";
import { formatDuration } from "#app/shared/services/podcasts";

interface PlayerState {
  playing: boolean;
  position: number[];
}

// The audio element is the one piece of the page whose state lives in the
// browser, so the controls reach it through the player they sit in.
function audioFor(target: EventTarget | null | undefined): HTMLAudioElement | null {
  return (target as HTMLElement | null)?.closest(".player")?.querySelector("audio") ?? null;
}

function onToggle(event: Event) {
  let audio = audioFor(event.currentTarget);

  if (!audio) {
    return;
  }

  if (audio.paused) {
    audio.play();
  } else {
    audio.pause();
  }
}

function onScrub(value: number[], details: SliderChangeDetails) {
  let audio = audioFor(details.event?.target);

  if (audio) {
    audio.currentTime = value[0];
  }
}

function onTime(event: Event, state: PlayerState) {
  state.position = [(event.currentTarget as HTMLAudioElement).currentTime];
}

<Player (
  src: string,
  duration: number,
  compact: boolean = false,
  private state: PlayerState = { playing: false, position: [0] },
)>
  <div class={["player", compact && "is-compact"]}>
    <audio preload="none"
           src={src}
           onplay={() => state.playing = true}
           onpause={() => state.playing = false}
           onended={() => state.playing = false}
           ontimeupdate={(e) => onTime(e, state)}></audio>

    <Button variant="primary" icon round size={compact ? "sm" : "lg"}
            label={state.playing ? "Pause" : "Play"}
            onclick={(e) => onToggle(e)}>
      <Icon e:if={state.playing} name="pause" />
      <Icon e:else name="play" />
    </Button>

    <Slider value={state.position} max={duration} step={0.1} label="Position"
            onValueChange={(value, details) => onScrub(value, details)} />

    <span class="player-time">{formatDuration(Math.floor(state.position[0]))} / {formatDuration(duration)}</span>
  </div>
</Player>
