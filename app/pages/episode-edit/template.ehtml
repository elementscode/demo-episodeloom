import "./style.css";
import { File, ValidationError, raw, redirect } from "@elements/app";
import { Alert } from "@elements/ui/alert";
import { AlertDialog, AlertDialogAction, AlertDialogCancel, AlertDialogFooter } from "@elements/ui/alert-dialog";
import { Button } from "@elements/ui/button";
import { Card, CardContent } from "@elements/ui/card";
import { DatePicker } from "@elements/ui/date-picker";
import { Field, FieldLabel, FieldLegend, FieldSet } from "@elements/ui/field";
import { Input } from "@elements/ui/input";
import { RadioGroup } from "@elements/ui/radio-group";
import { Tabs, TabsContent, TabsList, TabsTrigger } from "@elements/ui/tabs";
import { Textarea } from "@elements/ui/textarea";
import { TimePicker } from "@elements/ui/time-picker";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { Layout } from "#app/shared/templates/layout";
import { Player } from "#app/shared/templates/player";
import { Episode, Show, audioUrl, formatDuration, isPublished } from "#app/shared/services/podcasts";
import { renderNotes } from "#app/shared/services/markdown";
import { MAX_AUDIO_MB, deleteEpisode, saveEpisode } from "./services";

interface EpisodeDraft {
  title: string;
  number: string;
  notes: string;
  when: string;
  scheduleDate: string;
  scheduleTime: string;
  durationSeconds: number;
  audio?: File;
}

interface EditorState {
  draft: EpisodeDraft;
  errors: Record<string, string[]>;
  error: string;
  tab: string;
  saving: boolean;
}

const pad = (n: number) => String(n).padStart(2, "0");

/** A Date's day as the ISO date a DatePicker takes, in the browser's zone. */
function localDate(date: Date): string {
  let d = new Date(date);

  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
}

/** A Date's time of day as the HH:MM a TimePicker takes, in the browser's zone. */
function localTime(date: Date): string {
  let d = new Date(date);

  return `${pad(d.getHours())}:${pad(d.getMinutes())}`;
}

function tomorrowMorning(): Date {
  let d = new Date();
  d.setDate(d.getDate() + 1);
  d.setHours(7, 0, 0, 0);

  return d;
}

function initialState(episode: Episode | null, nextNumber: number): EditorState {
  let scheduled = episode ? !isPublished(episode) : false;
  let scheduleAt = scheduled ? episode!.publishAt : tomorrowMorning();

  return {
    draft: {
      title: episode?.title ?? "",
      number: String(episode?.number ?? nextNumber),
      notes: episode?.notes ?? "",
      when: scheduled ? "schedule" : "now",
      scheduleDate: localDate(scheduleAt),
      scheduleTime: localTime(scheduleAt),
      durationSeconds: episode?.durationSeconds ?? 0,
    },
    errors: {},
    error: "",
    tab: "write",
    saving: false,
  };
}

// The browser can read an audio file's length without uploading it, so the
// feed's itunes:duration comes from the file the podcaster picked.
function onAudioChange(event: Event, draft: EpisodeDraft) {
  let file = (event.currentTarget as HTMLInputElement).files?.[0];

  if (!file) {
    return;
  }

  let probe = new Audio();
  probe.preload = "metadata";
  probe.onloadedmetadata = () => {
    draft.durationSeconds = Math.round(probe.duration || 0);
    URL.revokeObjectURL(probe.src);
  };
  probe.src = URL.createObjectURL(file);
}

function publishDate(draft: EpisodeDraft, episode: Episode | null): Date {
  if (draft.when === "schedule") {
    return new Date(`${draft.scheduleDate}T${draft.scheduleTime}`);
  }

  // Keep an already-published episode's original date when it is edited.
  return episode && isPublished(episode) ? new Date(episode.publishAt) : new Date();
}

function onSubmit(state: EditorState, show: Show, episode: Episode | null) {
  state.saving = true;

  try {
    saveEpisode(show.id, episode?.id ?? "", {
      title: state.draft.title,
      number: Number(state.draft.number),
      notes: state.draft.notes,
      publishAt: publishDate(state.draft, episode),
      durationSeconds: state.draft.durationSeconds,
      audio: state.draft.audio,
    });
    state.errors = {};
    redirect("/dashboard");
  } catch (err: any) {
    if (err instanceof ValidationError && typeof err.errors === "object") {
      state.errors = err.errors as Record<string, string[]>;
      state.error = "Check the highlighted fields.";
    } else {
      state.error = err.message;
    }
  } finally {
    state.saving = false;
  }
}

function publishOptions(episode: Episode | null): { value: string; label: string }[] {
  return [
    { value: "now", label: episode && isPublished(episode) ? "Published" : "Publish now" },
    { value: "schedule", label: "Schedule" },
  ];
}

function onDelete(episode: Episode) {
  deleteEpisode(episode.id);
  redirect("/dashboard");
}

<html lang="en" class="page-episode-edit" (
  show: Show,
  episode: Episode | null,
  nextNumber: number,
  private state: EditorState = initialState(episode, nextNumber),
)>
  <head>
    <title>{episode ? `Edit ${episode.title}` : "New episode"} · {show.title}</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout width="is-form">
      <div class="stack is-xl">
        <div class="stack is-xs">
          <a href="/dashboard" class="text-sm">← Dashboard</a>
          <p class="eyebrow">{show.title}</p>
          <h1>{episode ? "Edit episode" : "New episode"}</h1>
        </div>

        <form class="card" onsubmit={() => onSubmit(state, show, episode)}>
          <div class="card-body stack is-lg">
            <Alert e:if={state.error} variant="danger" description={state.error} />

            <div class="form-grid episode-title-row">
              <Field label="Title" error={state.errors.title?.[0] ?? ""}>
                <Input value={state.draft.title} required attrs={{ id: "title" }} />
              </Field>

              <Field label="Episode number" error={state.errors.number?.[0] ?? ""}>
                <Input type="number" value={state.draft.number} required attrs={{ id: "number", min: 1 }} />
              </Field>
            </div>

            <Field label="Audio" error={state.errors.audio?.[0] ?? ""}
                   description={state.draft.audio ? `${state.draft.audio?.name} · ${formatDuration(state.draft.durationSeconds)}` : episode ? "Choose a file to replace the audio." : `MP3 or M4A, up to ${MAX_AUDIO_MB} MB.`}>
              <Player e:if={episode} src={audioUrl(show, episode!)} duration={episode!.durationSeconds} compact={true} />
              <input type="file" accept="audio/mpeg,audio/mp4,audio/x-m4a,.mp3,.m4a" value={state.draft.audio}
                     class={[state.errors.audio && "is-error"]}
                     onchange={(e) => onAudioChange(e, state.draft)}>
            </Field>

            <Field>
              <div class="head">
                <FieldLabel>Show notes</FieldLabel>
                <span class="helper">Markdown</span>
              </div>
              <Tabs value={state.tab} class="stack is-sm">
                <TabsList label="Show notes">
                  <TabsTrigger value="write">Write</TabsTrigger>
                  <TabsTrigger value="preview">Preview</TabsTrigger>
                </TabsList>
                <TabsContent value="write">
                  <Textarea value={state.draft.notes} rows={10} class="notes-input" attrs={{ id: "notes" }}
                            placeholder="What's this episode about? Links, timestamps and credits go here." />
                </TabsContent>
                <TabsContent value="preview">
                  <div class="notes-preview prose">{raw(renderNotes(state.draft.notes || "_Nothing to preview yet._"))}</div>
                </TabsContent>
              </Tabs>
            </Field>

            <FieldSet class="stack">
              <FieldLegend>Publish</FieldLegend>
              <RadioGroup value={state.draft.when} name="when" orientation="horizontal"
                          options={publishOptions(episode)} attrs={{ "aria-label": "Publish" }} />
              <Field e:if={state.draft.when === "schedule"} label="Goes live"
                     description="It joins the feed and your show page at this time."
                     error={state.errors.publishAt?.[0] ?? ""}>
                <div class="cluster">
                  <DatePicker value={state.draft.scheduleDate} required attrs={{ id: "scheduleAt" }} />
                  <TimePicker value={state.draft.scheduleTime} required label="Time" />
                </div>
              </Field>
            </FieldSet>
          </div>

          <div class="card-foot">
            <Button variant="ghost" href="/dashboard">Cancel</Button>
            <Button type="submit" variant="primary" loading={state.saving}>
              {state.draft.when === "schedule" ? "Schedule episode" : episode ? "Save changes" : "Publish episode"}
            </Button>
          </div>
        </form>

        <Card e:if={episode}>
          <CardContent class="row danger-zone">
            <div>
              <strong>Delete this episode</strong>
              <p class="hint">It leaves the feed, and its download history is removed.</p>
            </div>
            <AlertDialog title={`Delete "${episode!.title}"?`} description="Its downloads go with it.">
              <Button slot="trigger" variant="danger">Delete episode</Button>
              <AlertDialogFooter>
                <AlertDialogCancel>Cancel</AlertDialogCancel>
                <AlertDialogAction variant="danger" onclick={() => onDelete(episode!)}>Delete episode</AlertDialogAction>
              </AlertDialogFooter>
            </AlertDialog>
          </CardContent>
        </Card>
      </div>
    </Layout>
  </body>
</html>
