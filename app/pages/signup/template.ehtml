import "./style.css";
import { redirect } from "@elements/app";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { Layout } from "#app/shared/templates/layout";
import { MIN_PASSWORD, SignupForm, signup } from "#app/shared/services/auth";

interface SignupState {
  form: SignupForm;
  error: string;
}

function onSubmit(state: SignupState) {
  try {
    signup(state.form);
    state.error = "";
    redirect("/dashboard/shows/new");
  } catch (err: any) {
    state.error = err.message;
  }
}

<html lang="en" class="page-signup" (
  private state: SignupState = { form: { name: "", email: "", password: "" }, error: "" },
)>
  <head>
    <title>Create an account · episodeloom</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout>
      <div class="card auth-card">
        <div class="card-body">
          <form class="stack" onsubmit={() => onSubmit(state)}>
            <div class="stack is-xs">
              <h1>Start your podcast</h1>
              <p class="hint">Create an account, then set up your first show.</p>
            </div>

            <p e:if={state.error} class="error" role="alert">{state.error}</p>

            <div class="field">
              <label for="name">Your name</label>
              <input id="name" name="name" value={state.form.name} autocomplete="name" required>
            </div>

            <div class="field">
              <label for="email">Email</label>
              <input id="email" name="email" type="email" value={state.form.email}
                     autocomplete="email" autocapitalize="none" spellcheck={false} required>
            </div>

            <div class="field">
              <label for="password">Password</label>
              <input id="password" name="password" type="password" value={state.form.password}
                     autocomplete="new-password" minlength={MIN_PASSWORD} required>
              <p class="hint">At least {MIN_PASSWORD} characters.</p>
            </div>

            <button type="submit" class="is-primary is-block">Create account</button>

            <p class="hint">Already hosting? <a href="/signin">Sign in</a></p>
          </form>
        </div>
      </div>
    </Layout>
  </body>
</html>
