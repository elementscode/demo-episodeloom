import "./style.css";
import { redirect } from "@elements/app";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { Alert } from "@elements/ui/alert";
import { Button } from "@elements/ui/button";
import { Field } from "@elements/ui/field";
import { Input } from "@elements/ui/input";
import { Layout } from "#app/shared/templates/layout";
import { MIN_PASSWORD, SignupForm, signup } from "#app/shared/services/auth";

interface SignupState {
  form: SignupForm;
  error: string;
}

function onSubmit(state: SignupState) {
  try {
    signup(state.form);
    state.error = "";
    redirect("/dashboard/shows/new");
  } catch (err: any) {
    state.error = err.message;
  }
}

<html lang="en" class="page-signup" (
  private state: SignupState = { form: { name: "", email: "", password: "" }, error: "" },
)>
  <head>
    <title>Create an account · episodeloom</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout>
      <div class="card auth-card">
        <div class="card-body">
          <form class="stack" onsubmit={() => onSubmit(state)}>
            <div class="stack is-xs">
              <h1>Start your podcast</h1>
              <p class="hint">Create an account, then set up your first show.</p>
            </div>

            <Alert e:if={state.error} variant="danger" description={state.error} />

            <Field label="Your name">
              <Input required name="name" value={state.form.name} attrs={{ id: "name", autocomplete: "name" }} />
            </Field>

            <Field label="Email">
              <Input required type="email" name="email" value={state.form.email}
                     attrs={{ id: "email", autocomplete: "email", autocapitalize: "none", spellcheck: "false" }} />
            </Field>

            <Field label="Password" description={`At least ${MIN_PASSWORD} characters.`}>
              <Input required type="password" name="password" value={state.form.password}
                     attrs={{ id: "password", autocomplete: "new-password", minlength: MIN_PASSWORD }} />
            </Field>

            <Button type="submit" variant="primary" block>Create account</Button>

            <p class="hint">Already hosting? <a href="/signin">Sign in</a></p>
          </form>
        </div>
      </div>
    </Layout>
  </body>
</html>
