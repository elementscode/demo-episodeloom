import "./style.css";
import { File, ValidationError, redirect } from "@elements/app";
import { Alert } from "@elements/ui/alert";
import { Button } from "@elements/ui/button";
import { Checkbox } from "@elements/ui/checkbox";
import { Empty } from "@elements/ui/empty";
import { Field, FieldDescription, FieldLegend, FieldSet } from "@elements/ui/field";
import { Input } from "@elements/ui/input";
import { NativeSelect } from "@elements/ui/native-select";
import { Textarea } from "@elements/ui/textarea";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { Layout } from "#app/shared/templates/layout";
import { CATEGORIES, Show, coverUrl, showUrl } from "#app/shared/services/podcasts";
import { MAX_COVER, MIN_COVER, ShowForm, saveShow } from "./services";

interface EditorState {
  form: ShowForm;
  cover: File[];
  errors: Record<string, string[]>;
  error: string;
  preview: string;
  saving: boolean;
}

const LANGUAGES = [
  { code: "en", name: "English" },
  { code: "es", name: "Spanish" },
  { code: "fr", name: "French" },
  { code: "de", name: "German" },
  { code: "pt", name: "Portuguese" },
  { code: "it", name: "Italian" },
  { code: "nl", name: "Dutch" },
  { code: "sv", name: "Swedish" },
  { code: "ja", name: "Japanese" },
];

function initialState(show: Show | null, defaultAuthor: string): EditorState {
  return {
    form: {
      title: show?.title ?? "",
      description: show?.description ?? "",
      author: show?.author ?? defaultAuthor,
      category: show?.category ?? "",
      language: show?.language ?? "en",
      explicit: show?.explicit ?? false,
      applePodcastsUrl: show?.applePodcastsUrl ?? "",
      spotifyUrl: show?.spotifyUrl ?? "",
    },
    cover: [],
    errors: {},
    error: "",
    preview: show ? coverUrl(show) : "",
    saving: false,
  };
}

function onCoverChange(event: Event, state: EditorState) {
  let picked = (event.target as HTMLInputElement).files?.[0];

  if (picked) {
    state.preview = URL.createObjectURL(picked);
  }
}

function onSubmit(state: EditorState, showId: string) {
  state.saving = true;

  try {
    saveShow(showId, { ...state.form, cover: state.cover[0] });
    state.errors = {};
    state.error = "";
    redirect("/dashboard");
  } catch (err: any) {
    if (err instanceof ValidationError && typeof err.errors === "object") {
      state.errors = err.errors as Record<string, string[]>;
      state.error = "Check the highlighted fields.";
    } else {
      state.error = err.message;
    }
  } finally {
    state.saving = false;
  }
}

<html lang="en" class="page-show-edit" (
  show: Show | null,
  defaultAuthor: string,
  private state: EditorState = initialState(show, defaultAuthor),
)>
  <head>
    <title>{show ? `Edit ${show.title}` : "New show"} · episodeloom</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout width="is-form">
      <div class="stack is-xl">
        <div class="row editor-head">
          <div class="stack is-xs">
            <a href="/dashboard" class="text-sm">← Dashboard</a>
            <h1>{show ? "Edit show" : "New show"}</h1>
          </div>
          <Button e:if={show} variant="ghost" size="sm" href={showUrl(show!)}>View public page</Button>
        </div>

        <form class="card" onsubmit={() => onSubmit(state, show?.id ?? "")}>
          <div class="card-body stack is-lg">
            <Alert e:if={state.error} variant="danger" description={state.error} />

            <Field label="Cover art" error={state.errors.cover?.[0] ?? ""}>
              <div class="cover-field">
                <img e:if={state.preview} class="cover-preview" src={state.preview} alt="" width="128" height="128">
                <Empty e:else variant="outline" class="cover-empty" description="Square JPEG or PNG" />
                <div class="stack is-xs">
                  <Input type="file" files={state.cover} onchange={(e) => onCoverChange(e, state)}
                         attrs={{ accept: "image/jpeg,image/png" }} />
                  <FieldDescription>{MIN_COVER} to {MAX_COVER} pixels square, as Apple Podcasts and Spotify require.</FieldDescription>
                </div>
              </div>
            </Field>

            <Field label="Title" error={state.errors.title?.[0] ?? ""}>
              <Input value={state.form.title} required attrs={{ id: "title" }} />
            </Field>

            <Field label="Description" description="Shown in podcast apps and on your show page." error={state.errors.description?.[0] ?? ""}>
              <Textarea value={state.form.description} rows={4} required attrs={{ id: "description" }} />
            </Field>

            <div class="form-grid">
              <Field label="Author" error={state.errors.author?.[0] ?? ""}>
                <Input value={state.form.author} required attrs={{ id: "author" }} />
              </Field>

              <Field label="Category" error={state.errors.category?.[0] ?? ""}>
                <NativeSelect value={state.form.category} placeholder="Choose a category" required block
                              options={CATEGORIES.map((category) => ({ value: category, label: category.replace(" > ", " › ") }))}
                              attrs={{ id: "category" }} />
              </Field>

              <Field label="Language">
                <NativeSelect value={state.form.language} block
                              options={LANGUAGES.map((lang) => ({ value: lang.code, label: lang.name }))}
                              attrs={{ id: "language" }} />
              </Field>

              <FieldSet>
                <FieldLegend variant="label">Content</FieldLegend>
                <Field orientation="horizontal" label="Contains explicit content">
                  <Checkbox checked={state.form.explicit} />
                </Field>
              </FieldSet>
            </div>

            <FieldSet class="stack">
              <FieldLegend>Directory links (optional)</FieldLegend>
              <FieldDescription>After you submit your RSS feed to Apple Podcasts or Spotify, paste the show's link here so listeners go straight to it.</FieldDescription>

              <Field label="Apple Podcasts link" error={state.errors.applePodcastsUrl?.[0] ?? ""}>
                <Input type="url" value={state.form.applePodcastsUrl} placeholder="https://podcasts.apple.com/…" attrs={{ id: "apple" }} />
              </Field>

              <Field label="Spotify link" error={state.errors.spotifyUrl?.[0] ?? ""}>
                <Input type="url" value={state.form.spotifyUrl} placeholder="https://open.spotify.com/show/…" attrs={{ id: "spotify" }} />
              </Field>
            </FieldSet>
          </div>

          <div class="card-foot">
            <Button variant="ghost" href="/dashboard">Cancel</Button>
            <Button type="submit" variant="primary" loading={state.saving}>
              {show ? "Save changes" : "Create show"}
            </Button>
          </div>
        </form>
      </div>
    </Layout>
  </body>
</html>
