import "./style.css";
import { ValidationError, redirect } from "@elements/app";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { Layout } from "#app/shared/templates/layout";
import { CATEGORIES, Show, coverUrl, showUrl } from "#app/shared/services/podcasts";
import { MAX_COVER, MIN_COVER, ShowForm, saveShow } from "./services";

interface EditorState {
  form: ShowForm;
  errors: Record<string, string[]>;
  error: string;
  preview: string;
  saving: boolean;
}

const LANGUAGES = [
  { code: "en", name: "English" },
  { code: "es", name: "Spanish" },
  { code: "fr", name: "French" },
  { code: "de", name: "German" },
  { code: "pt", name: "Portuguese" },
  { code: "it", name: "Italian" },
  { code: "nl", name: "Dutch" },
  { code: "sv", name: "Swedish" },
  { code: "ja", name: "Japanese" },
];

function initialState(show: Show | null, defaultAuthor: string): EditorState {
  return {
    form: {
      title: show?.title ?? "",
      description: show?.description ?? "",
      author: show?.author ?? defaultAuthor,
      category: show?.category ?? "",
      language: show?.language ?? "en",
      explicit: show?.explicit ?? false,
      applePodcastsUrl: show?.applePodcastsUrl ?? "",
      spotifyUrl: show?.spotifyUrl ?? "",
    },
    errors: {},
    error: "",
    preview: show ? coverUrl(show) : "",
    saving: false,
  };
}

function onCoverChange(event: Event, state: EditorState) {
  let file = (event.currentTarget as HTMLInputElement).files?.[0];

  if (file) {
    state.preview = URL.createObjectURL(file);
  }
}

function onSubmit(state: EditorState, showId: string) {
  state.saving = true;

  try {
    saveShow(showId, state.form);
    state.errors = {};
    state.error = "";
    redirect("/dashboard");
  } catch (err: any) {
    if (err instanceof ValidationError && typeof err.errors === "object") {
      state.errors = err.errors as Record<string, string[]>;
      state.error = "Check the highlighted fields.";
    } else {
      state.error = err.message;
    }
  } finally {
    state.saving = false;
  }
}

<html lang="en" class="page-show-edit" (
  show: Show | null,
  defaultAuthor: string,
  private state: EditorState = initialState(show, defaultAuthor),
)>
  <head>
    <title>{show ? `Edit ${show.title}` : "New show"} · episodeloom</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout width="is-form">
      <div class="stack is-xl">
        <div class="row editor-head">
          <div class="stack is-xs">
            <a href="/dashboard" class="text-sm">← Dashboard</a>
            <h1>{show ? "Edit show" : "New show"}</h1>
          </div>
          <a e:if={show} class="button is-ghost is-sm" href={showUrl(show!)}>View public page</a>
        </div>

        <form class="card" onsubmit={() => onSubmit(state, show?.id ?? "")}>
          <div class="card-body stack is-lg">
            <p e:if={state.error} class="callout is-danger" role="alert">{state.error}</p>

            <div class="field">
              <label>Cover art</label>
              <div class="cover-field">
                <img e:if={state.preview} class="cover-preview" src={state.preview} alt="" width="128" height="128">
                <div e:else class="cover-empty">Square JPEG or PNG</div>
                <div class="stack is-xs">
                  <input type="file" accept="image/jpeg,image/png" value={state.form.cover}
                         class={[state.errors.cover && "is-error"]}
                         onchange={(e) => onCoverChange(e, state)}>
                  <p e:if={state.errors.cover} class="error">{state.errors.cover?.[0]}</p>
                  <p e:else class="hint">{MIN_COVER} to {MAX_COVER} pixels square, as Apple Podcasts and Spotify require.</p>
                </div>
              </div>
            </div>

            <div class="field">
              <label for="title">Title</label>
              <input id="title" value={state.form.title} class={[state.errors.title && "is-error"]} required>
              <p e:if={state.errors.title} class="error">{state.errors.title?.[0]}</p>
            </div>

            <div class="field">
              <label for="description">Description</label>
              <textarea id="description" value={state.form.description} rows="4"
                        class={[state.errors.description && "is-error"]} required/>
              <p e:if={state.errors.description} class="error">{state.errors.description?.[0]}</p>
              <p e:else class="hint">Shown in podcast apps and on your show page.</p>
            </div>

            <div class="form-grid">
              <div class="field">
                <label for="author">Author</label>
                <input id="author" value={state.form.author} class={[state.errors.author && "is-error"]} required>
                <p e:if={state.errors.author} class="error">{state.errors.author?.[0]}</p>
              </div>

              <div class="field">
                <label for="category">Category</label>
                <select id="category" value={state.form.category} class={[state.errors.category && "is-error"]} required>
                  <option value="">Choose a category</option>
                  <option e:for={category of CATEGORIES} value={category}>{category.replace(" > ", " › ")}</option>
                </select>
                <p e:if={state.errors.category} class="error">{state.errors.category?.[0]}</p>
              </div>

              <div class="field">
                <label for="language">Language</label>
                <select id="language" value={state.form.language}>
                  <option e:for={lang of LANGUAGES} value={lang.code}>{lang.name}</option>
                </select>
              </div>

              <div class="field">
                <label>Content</label>
                <label><input type="checkbox" checked={state.form.explicit}> Contains explicit content</label>
              </div>
            </div>

            <fieldset class="stack">
              <legend>Directory links (optional)</legend>
              <p class="hint">After you submit your RSS feed to Apple Podcasts or Spotify, paste the show's link here so listeners go straight to it.</p>

              <div class="field">
                <label for="apple">Apple Podcasts link</label>
                <input id="apple" type="url" value={state.form.applePodcastsUrl} placeholder="https://podcasts.apple.com/…"
                       class={[state.errors.applePodcastsUrl && "is-error"]}>
                <p e:if={state.errors.applePodcastsUrl} class="error">{state.errors.applePodcastsUrl?.[0]}</p>
              </div>

              <div class="field">
                <label for="spotify">Spotify link</label>
                <input id="spotify" type="url" value={state.form.spotifyUrl} placeholder="https://open.spotify.com/show/…"
                       class={[state.errors.spotifyUrl && "is-error"]}>
                <p e:if={state.errors.spotifyUrl} class="error">{state.errors.spotifyUrl?.[0]}</p>
              </div>
            </fieldset>
          </div>

          <div class="card-foot">
            <a class="button is-ghost" href="/dashboard">Cancel</a>
            <button type="submit" class={["is-primary", state.saving && "is-loading"]} disabled={state.saving}>
              {show ? "Save changes" : "Create show"}
            </button>
          </div>
        </form>
      </div>
    </Layout>
  </body>
</html>
