import "./style.css";
import { LiveView } from "@elements/app";
import { Badge } from "@elements/ui/badge";
import { Button } from "@elements/ui/button";
import { Card, CardContent, CardHeader } from "@elements/ui/card";
import type { ChartConfig } from "@elements/ui/chart";
import { BarChart } from "@elements/ui/chart-bar";
import { Empty, EmptyContent } from "@elements/ui/empty";
import { Table, TableCell, TableHead } from "@elements/ui/table";
import { Tabs, TabsContent, TabsList, TabsTrigger } from "@elements/ui/tabs";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { Layout } from "#app/shared/templates/layout";
import { DownloadDay, WINDOW_DAYS } from "#app/shared/services/downloads";
import {
  Episode,
  Show,
  coverUrl,
  episodeUrl,
  isPublished,
  showUrl,
} from "#app/shared/services/podcasts";
import { DayTotal, dailyTotals, episodeTotals, lastDays, sumLast } from "./stats";

interface Tile {
  id: string;
  label: string;
  value: number;
}

const CHART: ChartConfig = {
  count: { label: "Downloads", color: "var(--accent)" },
};

function tiles(totals: DayTotal[], episodes: Episode[], showId: string): Tile[] {
  let live = episodes.filter((e) => (!showId || e.showId === showId) && isPublished(e)).length;

  return [
    { id: "today", label: "Downloads today", value: totals[totals.length - 1]?.count ?? 0 },
    { id: "week", label: "Last 7 days", value: sumLast(totals, 7) },
    { id: "month", label: `Last ${WINDOW_DAYS} days`, value: sumLast(totals, WINDOW_DAYS) },
    { id: "episodes", label: "Episodes published", value: live },
  ];
}

function readout(totals: DayTotal[], active: number): string {
  let hit = totals[active];

  if (hit) {
    return `${hit.label}: ${hit.count.toLocaleString()} downloads`;
  }

  return "Hover a bar for the day's count";
}

function axisLabel(totals: DayTotal[], label: string): string {
  return label === totals[totals.length - 1]?.label ? "Today" : label;
}

function showEpisodes(episodes: Episode[], showId: string): Episode[] {
  return episodes.filter((e) => e.showId === showId);
}

function visibleShows(shows: Show[], showId: string): Show[] {
  return showId ? shows.filter((s) => s.id === showId) : shows;
}

function whenLabel(episode: Episode): string {
  let date = new Date(episode.publishAt).toLocaleString("en-US", { month: "short", day: "numeric", hour: "numeric", minute: "2-digit" });

  return isPublished(episode) ? `Published ${date}` : `Goes live ${date}`;
}

<html lang="en" class="page-dashboard" (
  shows: Show[],
  episodes: Episode[],
  downloads: LiveView<DownloadDay>,
  today: string,
)>
  <head>
    <title>Dashboard · episodeloom</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout width="is-wide">
      <div class="stack is-2xl">
        <div class="row dash-head">
          <div class="stack is-xs">
            <p class="eyebrow">Dashboard</p>
            <h1>Your shows</h1>
          </div>
          <div class="cluster">
            <Badge variant="success" dot>Live downloads</Badge>
            <Button variant="primary" href="/dashboard/shows/new">New show</Button>
          </div>
        </div>

        <Card e:if={shows.length === 0}>
          <Empty title="Start your first show" description="Add a title, cover art and a category. Then publish episodes and share the RSS feed.">
            <EmptyContent>
              <Button variant="primary" href="/dashboard/shows/new">Create a show</Button>
            </EmptyContent>
          </Empty>
        </Card>

        <Tabs e:elseif={shows.length > 1} value="all" class="stack is-xl">
          <TabsList label="Shows">
            <TabsTrigger value="all">All shows</TabsTrigger>
            <TabsTrigger e:for={show of shows} value={show.id}>{show.title}</TabsTrigger>
          </TabsList>
          <TabsContent value="all">
            <ShowStats {shows} {episodes} {downloads} {today} showId="" />
          </TabsContent>
          <TabsContent e:for={show of shows} value={show.id}>
            <ShowStats {shows} {episodes} {downloads} {today} showId={show.id} />
          </TabsContent>
        </Tabs>

        <ShowStats e:else {shows} {episodes} {downloads} {today} showId="" />
      </div>
    </Layout>
  </body>
</html>

<ShowStats (shows: Show[], episodes: Episode[], downloads: LiveView<DownloadDay>, today: string, showId: string)>
  <div class="stack is-2xl">
    <div class="stat-grid">
      <Card e:for={tile of tiles(dailyTotals(downloads, lastDays(today, WINDOW_DAYS), showId), episodes, showId)}>
        <CardContent>
          <p class="stat-label">{tile.label}</p>
          <p class="stat-value">{tile.value.toLocaleString()}</p>
        </CardContent>
      </Card>
    </div>

    <DownloadsChart totals={dailyTotals(downloads, lastDays(today, WINDOW_DAYS), showId)} />

    <Card e:for={show of visibleShows(shows, showId)}>
      <CardHeader>
        <div class="row show-panel-head">
          <img src={coverUrl(show)} alt="" width="44" height="44">
          <h2>{show.title}</h2>
          <div class="cluster is-sm">
            <Button variant="ghost" size="sm" href={showUrl(show)}>Public page</Button>
            <Button size="sm" href={`/dashboard/shows/${show.id}`}>Edit show</Button>
            <Button variant="primary" size="sm" href={`/dashboard/shows/${show.id}/episodes/new`}>New episode</Button>
          </div>
        </div>
      </CardHeader>
      <CardContent>
        <EpisodeTable {show} episodes={showEpisodes(episodes, show.id)} {downloads} {today} />
      </CardContent>
    </Card>
  </div>
</ShowStats>

<DownloadsChart (totals: DayTotal[], private state: { active: number } = { active: -1 })>
  <Card>
    <CardContent class="stack">
      <div class="row chart-head">
        <h2>Downloads per day</h2>
        <span class="chart-readout">{readout(totals, state.active)}</span>
      </div>

      <BarChart data={totals} config={CHART} x="label" series={["count"]}
                active={state.active}
                class="downloads-chart"
                label={`Daily downloads for the last ${totals.length} days`}
                barCategoryGap={2}
                categoryAxis={{ tickFormatter: (value) => axisLabel(totals, String(value)), interval: "preserveStartEnd", minTickGap: 24 }}
                valueAxis={{ tickFormatter: (value) => Number(value).toLocaleString(), tickCount: 5, allowDecimals: false }} />
    </CardContent>
  </Card>
</DownloadsChart>

<EpisodeTable (show: Show, episodes: Episode[], downloads: LiveView<DownloadDay>, today: string)>
  <p e:if={episodes.length === 0} class="hint">No episodes yet. Publish your first one to start your feed.</p>
  <Table e:else label={`${show.title} episodes`} class="episodes-table">
    <table>
      <thead>
        <tr>
          <TableHead>#</TableHead>
          <TableHead>Episode</TableHead>
          <TableHead class="hide-sm">Status</TableHead>
          <TableHead align="end">Today</TableHead>
          <TableHead align="end" class="hide-sm">7 days</TableHead>
          <TableHead align="end" class="hide-sm">30 days</TableHead>
          <TableHead><span class="visually-hidden">Actions</span></TableHead>
        </tr>
      </thead>
      <tbody>
        <tr e:for={episode of episodes}>
          <TableCell>{episode.number}</TableCell>
          <TableCell wrap>
            <a e:if={isPublished(episode)} href={episodeUrl(show, episode)}>{episode.title}</a>
            <span e:else>{episode.title}</span>
            <span class="episode-when">{whenLabel(episode)}</span>
          </TableCell>
          <TableCell class="hide-sm">
            <Badge e:if={isPublished(episode)} variant="success">Published</Badge>
            <Badge e:else variant="info">Scheduled</Badge>
          </TableCell>
          <TableCell align="end">{(episodeTotals(downloads, lastDays(today, WINDOW_DAYS)).get(episode.id)?.today ?? 0).toLocaleString()}</TableCell>
          <TableCell align="end" class="hide-sm">{(episodeTotals(downloads, lastDays(today, WINDOW_DAYS)).get(episode.id)?.week ?? 0).toLocaleString()}</TableCell>
          <TableCell align="end" class="hide-sm">{(episodeTotals(downloads, lastDays(today, WINDOW_DAYS)).get(episode.id)?.month ?? 0).toLocaleString()}</TableCell>
          <TableCell align="end"><a href={`/dashboard/episodes/${episode.id}`}>Edit</a></TableCell>
        </tr>
      </tbody>
    </table>
  </Table>
</EpisodeTable>
